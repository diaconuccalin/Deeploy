{
  "ci-deeploy": {
    "workflow_file": "ci-deeploy.yml",
    "display_name": "CI - Deeploy",
    "platform": "Multiple",
    "triggers": ["push", "pull_request", "workflow_dispatch"],
    "jobs": {
      "build-deeploy": {
        "description": "Build Deeploy package",
        "tests": [],
        "runner_script": null
      },
      "deeploy-memory-allocation": {
        "description": "Memory allocation strategy tests",
        "tests": ["Tests/CCT/CCT_1_16_16_8"],
        "runner_script": "testMVP.py",
        "configurations": {
          "platform": "Siracusa",
          "defaultMemLevel": "L2",
          "l1": [64000],
          "l2": [75000, 60000, 90000],
          "memAllocStrategy": ["MiniMalloc", "TetrisRandom"]
        }
      },
      "deeploy-state-serialization": {
        "description": "State serialization equality tests",
        "tests": ["Tests/simpleRegression"],
        "runner_script": "deeployStateEqualityTest.py",
        "configurations": {
          "platforms": ["QEMU-ARM", "Siracusa", "MemPool", "Generic"]
        }
      },
      "deeploy-memory-level-extension": {
        "description": "Memory level extension tests",
        "tests": ["Tests/simpleRegression"],
        "runner_script": "testMemoryLevelExtension.py",
        "configurations": {
          "platforms": ["QEMU-ARM", "Siracusa", "MemPool", "Generic"]
        }
      },
      "deeploy-tiler-extension": {
        "description": "Tiler extension tests",
        "tests": [
          "Tests/simpleRegression",
          "Tests/simpleCNN",
          "Tests/testMatMul",
          "Tests/testMaxPool"
        ],
        "runner_script": "testTilerExtension.py",
        "configurations": {
          "platform": "Siracusa",
          "l1_fail_case": 2000
        }
      },
      "deeploy-memory-allocation-extension": {
        "description": "Memory allocation extension tests",
        "tests": [
          "Tests/simpleRegression",
          "Tests/simpleCNN",
          "Tests/miniMobileNet",
          "Tests/miniMobileNetv2",
          "Tests/testMatMul",
          "Tests/testMaxPool"
        ],
        "runner_script": "testTilerExtension.py",
        "configurations": {
          "platform": "Siracusa"
        }
      },
      "deeploy-typing": {
        "description": "Type system tests",
        "tests": [],
        "runner_script": "testTypes.py"
      },
      "deeploy-debug": {
        "description": "Debug print and transformation tests",
        "tests": ["Tests/simpleRegression"],
        "runner_scripts": [
          "testPrintInputOutputTransformation.py",
          "testDebugPrintPass.py"
        ],
        "configurations": {
          "platforms": ["Generic", "Siracusa"]
        }
      },
      "deeploy-regex-matching": {
        "description": "Regex matching tests",
        "tests": [],
        "runner_script": "testRegexMatching.py"
      },
      "deeploy-test-dmas": {
        "description": "DMA tests",
        "tests": [],
        "runner_script": "testDmas.py"
      }
    }
  },

  "ci-deeploy-testing": {
    "workflow_file": "ci-deeploy-testing.yml",
    "display_name": "CI - Deeploy Testing",
    "platform": "Generic",
    "triggers": ["push", "pull_request", "workflow_dispatch"],
    "jobs": {
      "generate-network-type-inference": {
        "description": "Type inference tests with matrix",
        "tests": ["Tests/testTypeInferenceDifferentTypes"],
        "runner_script": "generateNetwork.py",
        "matrix": [
          {
            "name": "fail-input0",
            "platform": "Generic",
            "type_map": "A=int8_t B=int8_t C=int8_t",
            "offset_map": "A=0 B=0 C=0",
            "shouldFail": true
          },
          {
            "name": "fail-input2",
            "platform": "Generic",
            "type_map": "A=int16_t B=int8_t C=int16_t",
            "offset_map": "A=0 B=0 C=0",
            "shouldFail": true
          },
          {
            "name": "pass",
            "platform": "Generic",
            "type_map": "A=int16_t B=int8_t C=int32_t",
            "offset_map": "A=0 B=0 C=0",
            "shouldFail": false
          }
        ]
      }
    }
  },

